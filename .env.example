APP_NAME=penguinControl
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=penguincontrol
DB_USERNAME=penguincontrol
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="root@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Passwords for the two accounts `php artisan db:seed` creates // Leave them unset and
# the seeder generates a password and prints it once //
#SEED_ADMIN_PASSWORD=
#SEED_USER_PASSWORD=

# penguinControl // See config/penguin.php //

# Address that is notified when a registration is awaiting activation //
ADMIN_EMAIL=root@localhost
# Public IP address that vHosts are expected to resolve to //
SERVER_IP=127.0.0.1
# Where the "Databases" page sends users to manage their databases //
PHPMYADMIN_URL=http://localhost/phpmyadmin
# Domain a new user's default vHost is created under, as <username>.<domain> //
# Leave it empty and staff add the first vHost by hand //
DEFAULT_VHOST_DOMAIN=
# Optional // A path that exists only when home directory storage is mounted //
# ProblemSolver checks it before creating a missing document root // Leave unset and
# the user's own home directory answers the same question //
STORAGE_CHECK_PATH=

# Cosmetic extras, off by default //
HOLIDAY_THEME=false
EASTER_EGGS=false

# Feature switches // Each one gates a section of the panel //
USER_REGISTRATION=true
VHOST=true
FTP=true
DATABASE=true
MAIL=true
MAIL_USER=true
MAIL_FORWARD=true
# Serves editable CMS pages at /page/{name} and enables the public site menu //
WEBSITE=false
