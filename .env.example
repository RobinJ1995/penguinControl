APP_NAME=penguinControl
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=penguincontrol
DB_USERNAME=penguincontrol
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="root@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# penguinControl // See config/penguin.php //

# Address that is notified when a registration is awaiting activation //
ADMIN_EMAIL=root@localhost
# Public IP address that vHosts are expected to resolve to //
SERVER_IP=127.0.0.1
# Where the "Databases" page sends users to manage their databases //
PHPMYADMIN_URL=http://localhost/phpmyadmin

# Feature switches // Each one gates a section of the panel //
USER_REGISTRATION=true
VHOST=true
FTP=true
DATABASE=true
MAIL=true
MAIL_USER=true
MAIL_FORWARD=true
# Serves editable CMS pages at /page/{name} and enables the public site menu //
WEBSITE=false
