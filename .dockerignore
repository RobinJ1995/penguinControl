# Built inside the image, and host copies would shadow it. A development vendor/
# in particular carries the dev dependencies, and this image runs as production.
/node_modules
/vendor
/public/build
/public/hot
/public/storage

# Local state
/.git
/.env
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*
/.phpunit.cache
.phpunit.result.cache

# The parts of tests/ this image has no use for, so that editing a feature file
# or a step definition does not invalidate the source copy. tests/e2e/app is
# needed and stays: the Dockerfile copies the shims, the control plane, the vHost
# config and the entrypoint out of it. The runner image builds from a different
# context (tests/e2e) that this file does not govern.
/tests/Unit
/tests/Feature
/tests/TestCase.php
/tests/e2e/features
/tests/e2e/runner
/tests/e2e/reports

# Python bytecode from running the harness locally
__pycache__/
