# Built inside the image, and host copies would shadow it
/node_modules

# vendor/ is deliberately NOT excluded: see tests/e2e/app/Dockerfile, which
# installs it only when the build context does not already carry one. Its git
# metadata is, though: when composer has to fall back to source downloads it
# leaves full clones behind, which run to gigabytes and are useless at runtime.
/vendor/**/.git
/public/build
/public/hot
/public/storage
/public/export

# Local state
/.git
/.env
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/bootstrap/cache/*
/.phpunit.cache
.phpunit.result.cache

# Test artefacts
/tests/e2e/reports
